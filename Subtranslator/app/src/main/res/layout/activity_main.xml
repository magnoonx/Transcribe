<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Subtranslator"
        android:textAppearance="@style/TextAppearance.MaterialComponents.HeadlineSmall"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/inputSourceLanguage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/sourceLanguageLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Idioma de entrada (en, es, auto)"
        app:layout_constraintTop_toBottomOf="@+id/textTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputSourceLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/targetLanguageLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Idioma de salida (es, en, fr)"
        app:layout_constraintTop_toBottomOf="@+id/sourceLanguageLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputTargetLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/buttonSelectInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Seleccionar archivo SRT"
        app:layout_constraintTop_toBottomOf="@+id/targetLanguageLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/buttonTranslate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Traducir"
        app:layout_constraintTop_toBottomOf="@+id/buttonSelectInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchSaveDownloads"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Guardar en Downloads"
        app:layout_constraintTop_toBottomOf="@+id/buttonTranslate"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Listo"
        app:layout_constraintTop_toBottomOf="@+id/buttonTranslate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
